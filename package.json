{
  "name": "instaolvidar-browser",
  "productName": "InstaOlvidar Browser",
  "version": "0.1.0",
  "description": "A privacy-first browser that forgets instantly with DuckDuckGo search, tracker blocking and a Fire Button.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "leaflet": "^1.9.4"
  },
  "dependencies": {
    "tz-lookup": "^6.1.25"
  },
  "homepage": "https://github.com/jgm240/io-browser",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jgm240/io-browser.git"
  },
  "bugs": {
    "url": "https://github.com/jgm240/io-browser/issues"
  },
  "author": "InstaOlvidar Browser contributors",
  "build": {
    "appId": "io.browser.instaolvidar",
    "productName": "InstaOlvidar Browser",
    "copyright": "Copyright \u00a9 2026 InstaOlvidar Browser contributors",
    "artifactName": "InstaOlvidar-Browser-${version}-${os}-${arch}.${ext}",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "pagePreload.js",
      "trackers.js",
      "src/**/*",
      "ui/**/*",
      "pages/**/*",
      "backgrounds/**/*",
      "build/icon.png",
      "build/icon.svg",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "!**/*.map"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "InstaOlvidar-Browser-Setup-${version}-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Network;WebBrowser",
      "synopsis": "Privacy-first browser that forgets instantly",
      "maintainer": "InstaOlvidar Browser contributors <noreply@users.noreply.github.com>",
      "executableName": "io-browser",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
